{
  "name": "@uianatomy/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.js"
    },
    "./content-bundle.json": "./dist/content-bundle.json",
    "./implementations-bundle.json": "./dist/implementations-bundle.json",
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "import": "./dist/compare.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-content.mjs && node scripts/bundle-implementations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
