{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uianatomy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Static Assets (replaces Cloudflare Pages). The site/dist
  // directory holds astro build output (HTML + JSON APIs + .well-known
  // files + .md sidecars + OG PNGs + Pagefind index + sitemap).
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    // run_worker_first lets the worker intercept every request, including
    // ones that would otherwise be handled directly by the static-asset
    // server. Required because markdown negotiation needs to inspect the
    // Accept header on requests for HTML pages, which the asset server
    // would otherwise serve without invoking the worker at all.
    "run_worker_first": true,
    // drop-trailing-slash matches Astro's `trailingSlash: 'never'` config —
    // /components/modal serves directly without a 307 redirect to
    // /components/modal/. Removes a redirect hop from the SEO crawl path
    // and keeps canonical URLs (emitted as `<link rel="canonical">`) in
    // sync with what's actually served.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // P6-206 / ADR-037 — counts-only telemetry on the /mcp route: tool name +
  // best-effort subject id per call, no arguments/bodies/client identifiers.
  // Scoped to the MCP endpoint only; the human-facing site stays untouched
  // (docs/CLAUDE.md's no-analytics rule is unaffected).
  "analytics_engine_datasets": [
    { "binding": "MCP_ANALYTICS", "dataset": "uianatomy_mcp_calls" }
  ]
}
