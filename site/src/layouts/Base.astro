---
import '../styles/global.css';
import ViewSwitcher from '../components/ViewSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';

type View = 'designer' | 'dev' | 'bridge';

interface Props {
  title: string;
  description?: string;
  breadcrumb?: { name: string; href?: string }[];
  componentId?: string;
  view?: View;
  /**
   * OpenGraph type. Defaults to "website"; component pages override to
   * "article" so og:type matches the article:modified_time signal.
   */
  ogType?: 'website' | 'article';
  /**
   * ISO date emitted as <meta property="article:modified_time">. Pass the
   * canonical lastReviewed value for component pages.
   */
  articleModifiedTime?: string;
  /**
   * Per-page Schema.org JSON-LD object. Built via site/src/lib/jsonLd.ts
   * helpers. Stringified into a `<script type="application/ld+json">` tag.
   */
  jsonLd?: unknown;
}

const {
  title,
  description,
  breadcrumb,
  componentId,
  view,
  ogType = 'website',
  articleModifiedTime,
  jsonLd,
} = Astro.props;
const dataView = view ?? 'bridge';

// Per-page OpenGraph image. URL convention mirrors the page tree:
//   /                        -> /og/index.png
//   /components/modal        -> /og/components/modal.png
//   /components/modal/dev    -> /og/components/modal/dev.png
const trimmedPath = Astro.url.pathname.replace(/\/$/, '');
const ogPath = trimmedPath === '' ? '/og/index.png' : `/og${trimmedPath}.png`;
const ogImage = Astro.site ? new URL(ogPath, Astro.site).toString() : ogPath;
const pageTitle = `${title} — UI Anatomy`;

// Canonical URL — strip trailing slash, drop query string. With CF Workers
// Static Assets configured for `drop-trailing-slash` we serve at the
// no-slash form, so canonical follows that convention. Index and 404 page
// canonicals fall back to the site origin.
const canonicalUrl = Astro.site
  ? new URL(trimmedPath === '' ? '/' : trimmedPath, Astro.site).toString()
  : trimmedPath === '' ? '/' : trimmedPath;
---

<!doctype html>
<html lang="en" data-view={dataView}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="UI Anatomy changelog" href="/changelog.xml" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:site_name" content="UI Anatomy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preconnect" href="data:" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('uianatomy.theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a href="/" class="site-header__brand" aria-label="UI Anatomy home">
          <img class="site-header__wordmark" src="/brand/wordmark.svg" alt="UI Anatomy" width="158" height="28" />
        </a>
        {breadcrumb && breadcrumb.length > 0 && (
          <nav class="site-header__breadcrumb" aria-label="Breadcrumb">
            {breadcrumb.map((item, i) => (
              <Fragment>
                {i > 0 && <span aria-hidden="true">/</span>}
                {item.href ? <a href={item.href}>{item.name}</a> : <span>{item.name}</span>}
              </Fragment>
            ))}
          </nav>
        )}
        <div class="site-header__cluster">
          {componentId && view && <ViewSwitcher componentId={componentId} activeView={view} />}
          <a href="/compare" class="site-header__compare" aria-label="Compare two components">
            <Icon name="git-compare" size={16} />
          </a>
          <a href="/search" class="site-header__search" aria-label="Search">
            <Icon name="search" size={16} />
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p class="site-footer__brand">UI Anatomy — canonical reference for UI component anatomy.</p>
        <nav class="site-footer__nav" aria-label="Footer">
          <a href="/methodology">Methodology</a>
          <a href="/patterns">Patterns</a>
          <a href="/changelog">Changelog</a>
          <a href="/compare">Compare</a>
          <a href="/search">Search</a>
          <a href="/integrate">Integrate</a>
          <a href="https://github.com/DominikPieper/uianatomy" rel="external">Source</a>
        </nav>
      </div>
    </footer>

    <script>
      function syncOverflow() {
        document.querySelectorAll<HTMLElement>('.table-scroll').forEach((el) => {
          const overflow = el.scrollWidth > el.clientWidth + 1;
          el.dataset.overflow = String(overflow);
        });
      }
      syncOverflow();
      window.addEventListener('resize', syncOverflow);
      window.addEventListener('load', syncOverflow);
    </script>

    <script>
      import '../scripts/webmcp.client.ts';
    </script>
  </body>
</html>
