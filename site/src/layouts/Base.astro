---
import '../styles/global.css';
import ViewSwitcher from '../components/ViewSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';

type View = 'designer' | 'dev' | 'bridge';

interface Props {
  title: string;
  description?: string;
  breadcrumb?: { name: string; href?: string }[];
  componentId?: string;
  view?: View;
}

const { title, description, breadcrumb, componentId, view } = Astro.props;
const dataView = view ?? 'bridge';
---

<!doctype html>
<html lang="en" data-view={dataView}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — UI Anatomy</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="data:" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('uianatomy.theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a href="/" class="site-header__brand">
          <Icon name="square-stack" size={18} />
          <span>UI Anatomy</span>
        </a>
        {breadcrumb && breadcrumb.length > 0 && (
          <nav class="site-header__breadcrumb" aria-label="Breadcrumb">
            {breadcrumb.map((item, i) => (
              <Fragment>
                {i > 0 && <span aria-hidden="true">/</span>}
                {item.href ? <a href={item.href}>{item.name}</a> : <span>{item.name}</span>}
              </Fragment>
            ))}
          </nav>
        )}
        <div class="site-header__cluster">
          {componentId && view && <ViewSwitcher componentId={componentId} activeView={view} />}
          <a href="/search" class="site-header__search" aria-label="Search">
            <Icon name="search" size={16} />
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>

    <script>
      function syncOverflow() {
        document.querySelectorAll<HTMLElement>('.table-scroll').forEach((el) => {
          const overflow = el.scrollWidth > el.clientWidth + 1;
          el.dataset.overflow = String(overflow);
        });
      }
      syncOverflow();
      window.addEventListener('resize', syncOverflow);
      window.addEventListener('load', syncOverflow);
    </script>
  </body>
</html>
