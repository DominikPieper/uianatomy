---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AnatomyDiagram from './AnatomyDiagram.astro';
import AnatomyFilterBar from './AnatomyFilterBar.astro';
import SiteSidebar from './SiteSidebar.astro';
import ComponentTOC from './ComponentTOC.astro';
import WhenToUseSection from './sections/WhenToUseSection.astro';
import ImplementationsSection from './sections/ImplementationsSection.astro';
import Icon from './Icon.astro';
import { componentJsonLd } from '../lib/jsonLd';

interface Props {
  entry: CollectionEntry<'components'>;
}

const { entry } = Astro.props;
const component = entry.data;

const implementations = await getCollection(
  'implementations',
  (e) => e.data.componentId === component.id,
);

// ADR-038 — one page, one title/description per component (the three-URL
// per-view variants this used to carry are gone; role is a client-side lens
// now, not a distinct crawlable page).
const trimmedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const jsonLd = componentJsonLd({ component, pathname: trimmedPath });
---
<Base
  title={component.name}
  description={component.description}
  breadcrumb={[{ name: 'Components', href: '/' }, { name: component.name }]}
  componentId={component.id}
  ogType="article"
  articleModifiedTime={component.lastReviewed}
  jsonLd={jsonLd}
>
  <div class="component-shell">
    <SiteSidebar />
    <SiteSidebar variant="mobile" />
    <article class="component-shell__content" data-pagefind-body data-pagefind-meta={`title:${component.name}`}>
      <section class="component-hero">
        <p class="hero-eyebrow"><span data-view-eyebrow></span></p>
        <h1 class="component-name">
          {component.name}
        </h1>
        <p class="component-description">{component.description}</p>
        {component.alternateNames && component.alternateNames.length > 0 && (
          <p class="component-alt-names">
            <span class="component-alt-names__label">Also called</span>
            {component.alternateNames.map((a, i) => (
              <Fragment>
                {i > 0 && <span aria-hidden="true">·</span>}
                <span class="component-alt-names__alias">{a}</span>
              </Fragment>
            ))}
          </p>
        )}
      </section>

      <ComponentTOC />

      <WhenToUseSection component={component} />

      {component.intro && (
        <section class="component-intro" aria-label={`About ${component.name}`}>
          <p>{component.intro}</p>
        </section>
      )}

      <section aria-label="Anatomy">
        <figure class="figure anatomy-frame">
          <AnatomyFilterBar componentName={component.name} />
          <AnatomyDiagram component={component} />
          <figcaption class="figure-caption">Fig 1.1 · {component.name} · <span data-anatomy-caption></span></figcaption>
        </figure>
      </section>

      <ImplementationsSection implementations={implementations} />

      <slot />

      {component.lastReviewed && (
        <footer class="component-footer">
          <span>
            <Icon name="clock" size={12} /> Last reviewed <time datetime={component.lastReviewed}>{component.lastReviewed}</time>
          </span>
        </footer>
      )}
    </article>
  </div>
</Base>

<script>
  function findSlotId(el: Element | null): string | null {
    if (!el) return null;
    const target = (el as HTMLElement).closest('[data-slot]') as HTMLElement | null;
    return target?.dataset.slot ?? null;
  }
  function setHighlight(slotId: string | null) {
    document.querySelectorAll('.is-cross-highlighted').forEach((n) =>
      n.classList.remove('is-cross-highlighted'),
    );
    if (!slotId) return;
    const matches = document.querySelectorAll(
      `[data-slot="${CSS.escape(slotId)}"]`,
    );
    matches.forEach((m) => {
      if (!m.classList.contains('is-cross-pinned')) {
        m.classList.add('is-cross-highlighted');
      }
    });
  }
  let pinnedSlot: string | null = null;
  function setPin(slotId: string | null) {
    document.querySelectorAll('.is-cross-pinned').forEach((n) =>
      n.classList.remove('is-cross-pinned'),
    );
    pinnedSlot = slotId;
    if (!slotId) return;
    document
      .querySelectorAll(`[data-slot="${CSS.escape(slotId)}"]`)
      .forEach((m) => m.classList.add('is-cross-pinned'));
  }
  document.body.addEventListener('mouseover', (e) => {
    const slot = findSlotId(e.target as Element);
    setHighlight(slot);
  });
  document.body.addEventListener('mouseout', (e) => {
    const slot = findSlotId(e.target as Element);
    if (slot) setHighlight(null);
  });
  document.body.addEventListener('click', (e) => {
    const slot = findSlotId(e.target as Element);
    if (slot === null) {
      if (pinnedSlot) setPin(null);
      return;
    }
    setPin(slot === pinnedSlot ? null : slot);
  });
</script>
