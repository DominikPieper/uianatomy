---
import type { Component } from '@uianatomy/shared/schema';
import { resolveAnatomySVG } from '@uianatomy/shared/svg';
import { fileURLToPath } from 'node:url';
import { dirname, resolve } from 'node:path';

interface Props {
  component: Component;
  compact?: boolean;
}

const { component, compact = false } = Astro.props;

const here = dirname(fileURLToPath(import.meta.url));
const contentDir = resolve(here, '..', '..', '..', 'content', 'components');
const svg = await resolveAnatomySVG(component, { contentDir });

const hostClass = compact ? 'anatomy-host anatomy-host--compact' : 'anatomy-host';
---

<div class={hostClass} role="img" aria-label={`${component.name} anatomy diagram`}>
  <Fragment set:html={svg} />
</div>
