---
type IconName =
  | 'palette'
  | 'code'
  | 'git-compare'
  | 'sun'
  | 'moon'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'alert-triangle'
  | 'check'
  | 'keyboard'
  | 'accessibility'
  | 'volume-2'
  | 'clock'
  | 'link-2'
  | 'layers'
  | 'link'
  | 'search'
  | 'square-stack';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 16, strokeWidth = 1.5, class: className = '', label } = Astro.props;

