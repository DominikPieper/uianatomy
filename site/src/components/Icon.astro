---
import { Icon as IconifyIcon } from 'astro-icon/components';

type IconName =
  | 'palette'
  | 'code'
  | 'git-compare'
  | 'sun'
  | 'moon'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'alert-triangle'
  | 'check'
  | 'keyboard'
  | 'accessibility'
  | 'volume-2'
  | 'clock'
  | 'link-2'
  | 'layers'
  | 'link'
  | 'search'
  | 'square-stack';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 16, strokeWidth = 1.5, class: className = '', label } = Astro.props;

// Map our local IconName vocabulary to lucide iconify names. The two strings
// happen to coincide today; the indirection keeps the component's prop surface
// stable if we ever swap icon sets.
const NAME_MAP: Record<IconName, string> = {
  palette: 'lucide:palette',
  code: 'lucide:code',
  'git-compare': 'lucide:git-compare',
  sun: 'lucide:sun',
  moon: 'lucide:moon',
  'arrow-right': 'lucide:arrow-right',
  'arrow-up-right': 'lucide:arrow-up-right',
  'alert-triangle': 'lucide:alert-triangle',
  check: 'lucide:check',
  keyboard: 'lucide:keyboard',
  accessibility: 'lucide:accessibility',
  'volume-2': 'lucide:volume-2',
  clock: 'lucide:clock',
  'link-2': 'lucide:link-2',
  layers: 'lucide:layers',
  link: 'lucide:link',
  search: 'lucide:search',
  'square-stack': 'lucide:square-stack',
};

const iconifyName = NAME_MAP[name];
const cls = `icon ${className}`.trim();
---
{label ? (
  <IconifyIcon
    name={iconifyName}
    width={size}
    height={size}
    class={cls}
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    role="img"
    aria-label={label}
  />
) : (
  <IconifyIcon
    name={iconifyName}
    width={size}
    height={size}
    class={cls}
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  />
)}
