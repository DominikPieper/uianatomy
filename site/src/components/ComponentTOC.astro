---
// P6-198 / ADR-038 — "On this page" nav. Built client-side from the rendered
// .section-header elements rather than a hardcoded section list, so it can
// never drift from what actually rendered (conditional sections like motion/
// i18n/performance vary per component) and needs no change when a section is
// added or removed from ComponentView/PatternPageShell.
---
<nav class="component-toc" aria-label="On this page" data-component-toc hidden>
  <p class="component-toc__label">On this page</p>
  <ul class="component-toc__list"></ul>
</nav>

<script>
  function buildToc(): void {
    const nav = document.querySelector<HTMLElement>('[data-component-toc]');
    if (!nav) return;
    const list = nav.querySelector('ul');
    if (!list) return;
    const headers = document.querySelectorAll<HTMLElement>('.component-shell__content .section-header, .pattern .pattern__h2[id]');
    const entries: Array<{ id: string; title: string; role: string }> = [];
    headers.forEach((el) => {
      const heading = el.tagName === 'H2' ? el : el.querySelector('h2');
      const id = heading?.id;
      if (!id) return;
      const title = heading?.textContent?.trim() ?? '';
      const role = el.dataset.role ?? 'both';
      entries.push({ id, title, role });
    });
    if (entries.length < 3) return; // not worth a TOC on a short page
    list.innerHTML = '';
    for (const { id, title, role } of entries) {
      const li = document.createElement('li');
      li.dataset.role = role;
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = title;
      li.appendChild(a);
      list.appendChild(li);
    }
    nav.hidden = false;
  }
  buildToc();
</script>

<style>
  .component-toc {
    margin: 0 0 32px;
    padding: var(--s-3, 12px) var(--s-4, 16px);
    border: var(--bw-hair, 1px) solid var(--rule, var(--border-subtle));
    border-radius: var(--r-2, 6px);
    background: var(--paper-50, var(--surface-bg));
  }
  .component-toc__label {
    font-family: var(--font-mono);
    font-size: var(--fs-12, 12px);
    font-weight: 500;
    letter-spacing: var(--ls-caps, 0.04em);
    text-transform: uppercase;
    color: var(--ink-500, var(--fg-muted));
    margin: 0 0 8px;
  }
  .component-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .component-toc__list a {
    display: block;
    padding: 2px 0;
    font-size: var(--fs-13, 13px);
    color: var(--ink-700, var(--fg-muted));
    text-decoration: none;
    line-height: 1.3;
    white-space: nowrap;
  }
  .component-toc__list a:hover {
    color: var(--ink-900, var(--fg));
    text-decoration: underline;
  }
  /* Lens filtering dims off-role entries in the TOC too, same rule as the
     sections themselves (see [data-role] rules in global.css). */
  :root[data-view='designer'] .component-toc__list li[data-role='dev'] a,
  :root[data-view='dev'] .component-toc__list li[data-role='designer'] a {
    opacity: 0.45;
  }
</style>
