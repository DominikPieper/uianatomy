---
import type { ComponentDiff } from '@uianatomy/shared/compare';
import { renderDiffHtml } from '../../lib/compareDiffHtml';

interface Props {
  diff: ComponentDiff;
}

const { diff } = Astro.props;
// Markup is produced by the shared renderDiffHtml() so the build-time render
// here and the /compare client re-render stay byte-identical (P6-166). Styles
// live in global.css (`.compare-diff*`) so the client-injected HTML is styled.
---
<Fragment set:html={renderDiffHtml(diff)} />
