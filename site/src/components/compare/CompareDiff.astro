---
import type { ComponentDiff } from '@uianatomy/shared/compare';

interface Props {
  diff: ComponentDiff;
}

const { diff } = Astro.props;

const optionalLabels: Record<keyof ComponentDiff['optionalBlocks'], string> = {
  motion: 'motion',
  responsive: 'responsive',
  transitions: 'state transitions',
  events: 'events',
  formIntegration: 'form integration',
  a11yAcceptance: 'a11y acceptance',
  performance: 'performance thresholds',
};

const optionalRows = (Object.keys(optionalLabels) as Array<keyof ComponentDiff['optionalBlocks']>).map((key) => ({
  key,
  label: optionalLabels[key],
  a: diff.optionalBlocks[key].a,
  b: diff.optionalBlocks[key].b,
}));
---
<section class="compare-diff" aria-labelledby="compare-diff-heading">
  <h2 id="compare-diff-heading" class="section-rule">Diff</h2>

  {(diff.vsRelated.aMentionsB || diff.vsRelated.bMentionsA) && (
    <div class="compare-diff__vs">
      <h3 class="compare-diff__h3">From the canon</h3>
      {diff.vsRelated.aMentionsB && (
        <p class="compare-diff__quote">
          <strong>{diff.names.a}</strong> on <strong>{diff.names.b}</strong>:
          {' '}<em>{diff.vsRelated.aMentionsB}</em>
        </p>
      )}
      {diff.vsRelated.bMentionsA && (
        <p class="compare-diff__quote">
          <strong>{diff.names.b}</strong> on <strong>{diff.names.a}</strong>:
          {' '}<em>{diff.vsRelated.bMentionsA}</em>
        </p>
      )}
    </div>
  )}

  <div class="compare-diff__grid">
    <div class="compare-diff__row">
      <h3 class="compare-diff__h3">Anatomy slots</h3>
      <dl>
        {diff.anatomy.requiredOnlyInA.length > 0 && (
          <Fragment>
            <dt>Required only in {diff.names.a}</dt>
            <dd>{diff.anatomy.requiredOnlyInA.map((id) => <code>{id}</code>)}</dd>
          </Fragment>
        )}
        {diff.anatomy.requiredOnlyInB.length > 0 && (
          <Fragment>
            <dt>Required only in {diff.names.b}</dt>
            <dd>{diff.anatomy.requiredOnlyInB.map((id) => <code>{id}</code>)}</dd>
          </Fragment>
        )}
        {diff.anatomy.optionalOnlyInA.length > 0 && (
          <Fragment>
            <dt>Optional only in {diff.names.a}</dt>
            <dd>{diff.anatomy.optionalOnlyInA.map((id) => <code>{id}</code>)}</dd>
          </Fragment>
        )}
        {diff.anatomy.optionalOnlyInB.length > 0 && (
          <Fragment>
            <dt>Optional only in {diff.names.b}</dt>
            <dd>{diff.anatomy.optionalOnlyInB.map((id) => <code>{id}</code>)}</dd>
          </Fragment>
        )}
        {diff.anatomy.shared.length > 0 && (
          <Fragment>
            <dt>Slot ids in both</dt>
            <dd>{diff.anatomy.shared.map((id) => <code>{id}</code>)}</dd>
          </Fragment>
        )}
      </dl>
    </div>

    <div class="compare-diff__row">
      <h3 class="compare-diff__h3">Variants</h3>
      <dl>
        {diff.variants.onlyInA.length > 0 && (
          <Fragment>
            <dt>Only in {diff.names.a}</dt>
            <dd>{diff.variants.onlyInA.join(', ')}</dd>
          </Fragment>
        )}
        {diff.variants.onlyInB.length > 0 && (
          <Fragment>
            <dt>Only in {diff.names.b}</dt>
            <dd>{diff.variants.onlyInB.join(', ')}</dd>
          </Fragment>
        )}
        {diff.variants.shared.length > 0 && (
          <Fragment>
            <dt>Shared</dt>
            <dd>{diff.variants.shared.join(', ')}</dd>
          </Fragment>
        )}
      </dl>
    </div>

    <div class="compare-diff__row">
      <h3 class="compare-diff__h3">Properties</h3>
      <dl>
        {diff.properties.onlyInA.length > 0 && (
          <Fragment>
            <dt>Only in {diff.names.a}</dt>
            <dd>{diff.properties.onlyInA.join(', ')}</dd>
          </Fragment>
        )}
        {diff.properties.onlyInB.length > 0 && (
          <Fragment>
            <dt>Only in {diff.names.b}</dt>
            <dd>{diff.properties.onlyInB.join(', ')}</dd>
          </Fragment>
        )}
        {diff.properties.sharedDifferentKind.length > 0 && (
          <Fragment>
            <dt>Same name, different kind</dt>
            <dd>
              {diff.properties.sharedDifferentKind.map((p) => (
                <div><code>{p.name}</code> — {diff.names.a}: <em>{p.aKind}</em> · {diff.names.b}: <em>{p.bKind}</em></div>
              ))}
            </dd>
          </Fragment>
        )}
        {diff.properties.sharedSameKind.length > 0 && (
          <Fragment>
            <dt>Same name and kind</dt>
            <dd>{diff.properties.sharedSameKind.join(', ')}</dd>
          </Fragment>
        )}
      </dl>
    </div>

    <div class="compare-diff__row">
      <h3 class="compare-diff__h3">Interactive states</h3>
      <dl>
        {diff.interactiveStates.onlyInA.length > 0 && (
          <Fragment>
            <dt>Only in {diff.names.a}</dt>
            <dd>{diff.interactiveStates.onlyInA.join(', ')}</dd>
          </Fragment>
        )}
        {diff.interactiveStates.onlyInB.length > 0 && (
          <Fragment>
            <dt>Only in {diff.names.b}</dt>
            <dd>{diff.interactiveStates.onlyInB.join(', ')}</dd>
          </Fragment>
        )}
        {diff.interactiveStates.shared.length > 0 && (
          <Fragment>
            <dt>Shared</dt>
            <dd>{diff.interactiveStates.shared.join(', ')}</dd>
          </Fragment>
        )}
      </dl>
    </div>

    <div class="compare-diff__row">
      <h3 class="compare-diff__h3">Data states</h3>
      <dl>
        {diff.dataStates.onlyInA.length > 0 && (
          <Fragment>
            <dt>Only in {diff.names.a}</dt>
            <dd>{diff.dataStates.onlyInA.join(', ')}</dd>
          </Fragment>
        )}
        {diff.dataStates.onlyInB.length > 0 && (
          <Fragment>
            <dt>Only in {diff.names.b}</dt>
            <dd>{diff.dataStates.onlyInB.join(', ')}</dd>
          </Fragment>
        )}
        {diff.dataStates.shared.length > 0 && (
          <Fragment>
            <dt>Shared</dt>
            <dd>{diff.dataStates.shared.join(', ')}</dd>
          </Fragment>
        )}
      </dl>
    </div>

    <div class="compare-diff__row">
      <h3 class="compare-diff__h3">Schema sections declared</h3>
      <table class="compare-diff__matrix">
        <thead>
          <tr>
            <th></th>
            <th>{diff.names.a}</th>
            <th>{diff.names.b}</th>
          </tr>
        </thead>
        <tbody>
          {optionalRows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class:list={[row.a !== row.b && 'is-diff']}>{row.a ? '✓' : '—'}</td>
              <td class:list={[row.a !== row.b && 'is-diff']}>{row.b ? '✓' : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {(diff.axeRules.onlyInA.length + diff.axeRules.onlyInB.length + diff.axeRules.shared.length) > 0 && (
      <div class="compare-diff__row">
        <h3 class="compare-diff__h3">axe-core rules</h3>
        <dl>
          {diff.axeRules.onlyInA.length > 0 && (
            <Fragment>
              <dt>Only in {diff.names.a}</dt>
              <dd>{diff.axeRules.onlyInA.map((r) => <code>{r}</code>)}</dd>
            </Fragment>
          )}
          {diff.axeRules.onlyInB.length > 0 && (
            <Fragment>
              <dt>Only in {diff.names.b}</dt>
              <dd>{diff.axeRules.onlyInB.map((r) => <code>{r}</code>)}</dd>
            </Fragment>
          )}
          {diff.axeRules.shared.length > 0 && (
            <Fragment>
              <dt>Shared</dt>
              <dd>{diff.axeRules.shared.map((r) => <code>{r}</code>)}</dd>
            </Fragment>
          )}
        </dl>
      </div>
    )}
  </div>
</section>

<style>
  .compare-diff {
    margin: var(--s-8) 0;
  }
  .compare-diff__vs {
    background: var(--paper-100);
    border-left: 3px solid var(--accent-active);
    padding: var(--s-4) var(--s-5);
    margin: 0 0 var(--s-6);
    border-radius: var(--r-2);
  }
  .compare-diff__quote {
    margin: 0;
    line-height: var(--lh-loose);
    color: var(--ink-700);
  }
  .compare-diff__quote + .compare-diff__quote {
    margin-top: var(--s-3);
  }
  .compare-diff__grid {
    display: grid;
    gap: var(--s-6);
  }
  .compare-diff__row {
    border-top: var(--bw-hair) solid var(--rule);
    padding-top: var(--s-5);
  }
  .compare-diff__h3 {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 500;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--ink-500);
    margin: 0 0 var(--s-3);
  }
  .compare-diff__row dl {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: var(--s-2) var(--s-5);
    margin: 0;
  }
  .compare-diff__row dt {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--ink-500);
  }
  .compare-diff__row dd {
    margin: 0;
    color: var(--ink-900);
    line-height: var(--lh-loose);
    font-size: var(--fs-14);
    overflow-wrap: anywhere;
  }
  .compare-diff__row dd code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--paper-100);
    padding: 1px 6px;
    border-radius: var(--r-2);
    margin-right: 2px;
  }
  .compare-diff__matrix {
    width: 100%;
    border-collapse: collapse;
  }
  .compare-diff__matrix th,
  .compare-diff__matrix td {
    text-align: left;
    padding: var(--s-2) var(--s-3);
    border-bottom: var(--bw-hair) solid var(--rule);
    font-size: var(--fs-14);
  }
  .compare-diff__matrix th[scope='row'] {
    font-family: var(--font-mono);
    color: var(--ink-500);
    font-weight: 400;
  }
  .compare-diff__matrix td.is-diff {
    background: color-mix(in oklab, var(--accent-active) 12%, transparent);
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .compare-diff__row dl {
      grid-template-columns: 1fr;
      gap: var(--s-1) 0;
    }
    .compare-diff__row dt {
      margin-top: var(--s-2);
    }
  }
</style>
