---
import Icon from './Icon.astro';

type View = 'designer' | 'dev' | 'bridge';

interface Props {
  componentId: string;
  activeView: View;
  basePath?: string;
}

const { componentId, activeView, basePath = '/components' } = Astro.props;

type IconName = 'palette' | 'code' | 'git-compare';

const VIEWS: Array<{ value: View; label: string; icon: IconName; href: string }> = [
  { value: 'designer', label: 'Designer', icon: 'palette', href: `${basePath}/${componentId}` },
  { value: 'dev', label: 'Dev', icon: 'code', href: `${basePath}/${componentId}/dev` },
  { value: 'bridge', label: 'Bridge', icon: 'git-compare', href: `${basePath}/${componentId}/bridge` },
];
---
<nav class="view-tabs" aria-label="View" data-component-id={componentId}>
  {VIEWS.map(({ value, label, icon, href }) => {
    const isActive = value === activeView;
    return (
      <a
        href={href}
        data-view-value={value}
        aria-current={isActive ? 'page' : undefined}
      >
        <Icon name={icon} size={14} />
        <span class="label">{label}</span>
      </a>
    );
  })}
</nav>

<script is:inline>
  (() => {
    const PREFIX = 'uianatomy:scrollY:';
    const LAST = PREFIX + '__last';
    const nav = document.querySelector('nav.view-tabs[data-component-id]');
    if (!nav) return;
    const id = nav.dataset.componentId;
    if (!id) return;
    const key = PREFIX + id;

    nav.querySelectorAll('a[data-view-value]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        try {
          sessionStorage.setItem(key, String(window.scrollY));
          sessionStorage.setItem(LAST, id);
        } catch (_) {}
      });
    });

    const navEntry = performance.getEntriesByType('navigation')[0];
    if (navEntry && navEntry.type === 'back_forward') return;

    try {
      if (sessionStorage.getItem(LAST) !== id) return;
      const raw = sessionStorage.getItem(key);
      if (raw == null) return;
      const y = parseInt(raw, 10);
      if (!Number.isFinite(y)) return;
      requestAnimationFrame(() => {
        const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        window.scrollTo({ top: Math.min(y, max), behavior: 'instant' });
      });
      sessionStorage.removeItem(key);
      sessionStorage.removeItem(LAST);
    } catch (_) {}
  })();
</script>
