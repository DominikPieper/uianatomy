---
import Icon from './Icon.astro';

type View = 'designer' | 'dev' | 'bridge';

interface Props {
  componentId: string;
  activeView: View;
}

const { componentId, activeView } = Astro.props;

const VIEWS: Array<{ value: View; label: string; icon: string; href: string }> = [
  { value: 'designer', label: 'Designer', icon: 'palette', href: `/components/${componentId}` },
  { value: 'dev', label: 'Dev', icon: 'code', href: `/components/${componentId}/dev` },
  { value: 'bridge', label: 'Bridge', icon: 'git-compare', href: `/components/${componentId}/bridge` },
];
---
<nav class="view-tabs" aria-label="View">
  {VIEWS.map(({ value, label, icon, href }) => {
    const isActive = value === activeView;
    return (
      <a
        href={href}
        data-view-value={value}
        aria-current={isActive ? 'page' : undefined}
      >
        <Icon name={icon} size={14} />
        <span class="label">{label}</span>
      </a>
    );
  })}
</nav>
