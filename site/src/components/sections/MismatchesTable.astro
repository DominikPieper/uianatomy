---
import type { Component } from '@uianatomy/shared/schema';
import Icon from '../Icon.astro';
interface Props { component: Component }
const { component } = Astro.props;
---
<div class="mismatches">
  <ol class="mismatch-list">
    {component.mismatches.map((m, i) => (
      <li class="mismatch">
        <span class="mismatch__index">{String(i + 1).padStart(2, '0')}</span>
        <div class="mismatch__pair">
          <div class="mismatch__side mismatch__side--figma">
            <span class="mismatch__label"><Icon name="palette" size={12} /> Figma</span>
            <p>{m.figma}</p>
          </div>
          <span class="mismatch__arrow" aria-hidden="true">
            <Icon name="arrow-right" size={16} />
          </span>
          <div class="mismatch__side mismatch__side--code">
            <span class="mismatch__label"><Icon name="code" size={12} /> Code</span>
            <p>{m.code}</p>
          </div>
        </div>
        <div class="mismatch__rows">
          <div class="mismatch__row mismatch__row--consequence">
            <span class="mismatch__row-label"><Icon name="alert-triangle" size={12} /> Consequence</span>
            <p>{m.consequence}</p>
          </div>
          <div class="mismatch__row mismatch__row--correct">
            <span class="mismatch__row-label"><Icon name="check" size={12} /> Correct</span>
            <p>{m.correct}</p>
          </div>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .mismatch-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-4);
  }
  .mismatch {
    position: relative;
    padding: 0;
    background: var(--paper-50);
    border: var(--bw-hair) solid var(--paper-200);
    border-radius: var(--r-2);
    overflow: hidden;
  }
  .mismatch__index {
    position: absolute;
    top: var(--s-2);
    right: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--ink-400);
    letter-spacing: var(--ls-wide);
    z-index: 1;
  }
  .mismatch__pair {
    display: grid;
    grid-template-columns: 1fr 28px 1fr;
    gap: 0;
    align-items: stretch;
  }
  @media (max-width: 640px) {
    .mismatch__pair {
      grid-template-columns: 1fr;
    }
  }
  .mismatch__side {
    padding: var(--s-4);
  }
  .mismatch__side--figma {
    background: var(--designer-50);
  }
  .mismatch__side--code {
    background: var(--dev-50);
  }
  .mismatch__side p {
    margin: var(--s-1) 0 0;
    color: var(--ink-900);
    font-size: var(--fs-14);
    line-height: var(--lh-normal);
  }
  .mismatch__label,
  .mismatch__row-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
  }
  .mismatch__side--figma .mismatch__label {
    color: var(--designer-700);
  }
  .mismatch__side--code .mismatch__label {
    color: var(--dev-700);
  }
  .mismatch__arrow {
    background: var(--highlight);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-700);
    border-left: var(--bw-hair) solid var(--paper-200);
    border-right: var(--bw-hair) solid var(--paper-200);
  }
  @media (max-width: 640px) {
    .mismatch__arrow {
      border-left: 0;
      border-right: 0;
      border-top: var(--bw-hair) solid var(--paper-200);
      border-bottom: var(--bw-hair) solid var(--paper-200);
      padding: var(--s-1) 0;
    }
    .mismatch__arrow svg {
      transform: rotate(90deg);
    }
  }
  .mismatch__rows {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4);
    border-top: var(--bw-hair) solid var(--paper-200);
  }
  .mismatch__row p {
    margin: var(--s-1) 0 0;
    color: var(--ink-700);
    font-size: var(--fs-14);
    line-height: var(--lh-normal);
  }
  .mismatch__row--consequence .mismatch__row-label {
    color: var(--designer-700);
  }
  .mismatch__row--correct .mismatch__row-label {
    color: var(--dev-700);
  }
</style>
