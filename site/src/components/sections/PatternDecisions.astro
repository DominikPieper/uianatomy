---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'patterns'>;
}
const { entry } = Astro.props;
const pattern = entry.data;
---
<section class="pattern__section" aria-labelledby="decisions">
  <h2 id="decisions" class="pattern__h2">Canonical decisions</h2>
  <ol class="pattern__decisions">
    {pattern.decisions.map((d) => (
      <li>
        <h3 class="pattern__decision-q">{d.question}</h3>
        <p class="pattern__decision-a"><strong>{d.answer}</strong></p>
        <p class="pattern__decision-r">{d.rationale}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .pattern__section {
    margin-block: 48px;
  }
  .pattern__h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .pattern__decisions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .pattern__decisions li {
    border-left: 2px solid var(--accent-active);
    padding: 4px 0 4px 16px;
  }
  .pattern__decision-q {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0 0 6px;
  }
  .pattern__decision-a,
  .pattern__decision-r {
    margin: 0 0 6px;
    line-height: 1.6;
  }
</style>
