---
import type { Component } from '@uianatomy/shared/schema';
interface Props { component: Component }
const { component } = Astro.props;
---
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Slot</th>
        <th>Code slot</th>
        <th>Semantic</th>
      </tr>
    </thead>
    <tbody>
      {component.anatomy.map((s) => (
        <tr data-slot={s.id}>
          <td><code>{s.id}</code></td>
          <td><code>{s.code.slot}</code></td>
          <td>{s.code.semantic}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
