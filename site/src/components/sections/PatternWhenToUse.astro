---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'patterns'>;
}
const { entry } = Astro.props;
const pattern = entry.data;
---
<section class="pattern__section" aria-labelledby="when-to-use">
  <h2 id="when-to-use" class="pattern__h2">When to use</h2>
  <dl class="pattern__when">
    <dt>Use</dt>
    <dd>{pattern.whenToUse.use}</dd>
    <dt>Avoid</dt>
    <dd>{pattern.whenToUse.avoid}</dd>
  </dl>
</section>

<style>
  .pattern__section {
    margin-block: 48px;
  }
  .pattern__h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .pattern__when {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 24px;
    margin: 0;
  }
  .pattern__when dt {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    padding-top: 4px;
  }
  .pattern__when dd {
    margin: 0;
    line-height: 1.65;
  }
</style>
