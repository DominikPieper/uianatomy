---
import type { Component } from '@uianatomy/shared/schema';
import { formatPropertyType } from '@uianatomy/shared/format';
interface Props { component: Component }
const { component } = Astro.props;
const { axes } = component;
---
<div class="axes">
  <div class="axes__group">
    <h3>Variants</h3>
    <p>Structurally different versions of the component.</p>
    <div class="variant-list">
      {axes.variants.map((v) => {
        const aliases = v.alternativeNames ?? [];
        return (
          <span class="chip-wrap">
            <code class="chip">{v.name}</code>
            {aliases.length > 0 && (
              <span class="variant-aliases">aka {aliases.join(' · ')}</span>
            )}
          </span>
        );
      })}
    </div>
  </div>

  <div class="axes__group">
    <h3>Properties</h3>
    <p>The same component, parameterised.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Property</th><th>Type</th></tr></thead>
        <tbody>
          {axes.properties.map((p) => (
            <tr>
              <td>
                <code>{p.name}</code>
              </td>
              <td><code>{formatPropertyType(p)}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="axes__group">
    <h3>States</h3>
    <p>Browser/user-driven (interactive) vs. app-driven (data).</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Kind</th><th>States</th></tr></thead>
        <tbody>
          <tr>
            <td><code>interactive</code></td>
            <td>
              <div class="chip-row">{axes.states.interactive.map((s) => <code class="chip">{s}</code>)}</div>
            </td>
          </tr>
          <tr>
            <td><code>data</code></td>
            <td>
              <div class="chip-row">{axes.states.data.map((s) => <code class="chip">{s}</code>)}</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .axes {
    display: grid;
    gap: 24px;
  }
  .axes__group h3 {
    margin: 0 0 4px;
  }
  .axes__group p {
    margin: 0 0 12px;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip-row .chip {
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    padding: 3px 8px;
  }
  .variant-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }
  .chip-wrap {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .variant-aliases {
    font-style: italic;
    color: var(--ink-muted);
    font-size: 0.85em;
  }
</style>
