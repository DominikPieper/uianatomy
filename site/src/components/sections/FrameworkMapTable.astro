---
import type { Component } from '@uianatomy/shared/schema';
interface Props { component: Component }
const { component } = Astro.props;
// ADR-036 — only react is guaranteed; filter out frameworks the component
// didn't declare instead of rendering an empty row.
const entries = Object.entries(component.frameworkMap).filter(
  ([, val]) => val !== undefined,
) as [string, { structureMechanism: string; variantMechanism: string }][];
const labels: Record<string, string> = {
  webComponents: 'Web Components',
  react: 'React',
  angularSignals: 'Angular (signals)',
  vue: 'Vue',
};
---
<div class="table-scroll">
  <table>
    <thead>
      <tr><th>Framework</th><th>Structure mechanism</th><th>Variant mechanism</th></tr>
    </thead>
    <tbody>
      {entries.map(([key, val]) => (
        <tr>
          <td><strong>{labels[key] ?? key}</strong></td>
          <td>{val.structureMechanism}</td>
          <td><code>{val.variantMechanism}</code></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
