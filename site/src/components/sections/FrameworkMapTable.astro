---
import type { Component } from '@uianatomy/shared/schema';
interface Props { component: Component }
const { component } = Astro.props;
const entries = Object.entries(component.frameworkMap) as [string, { structureMechanism: string; variantMechanism: string }][];
const labels: Record<string, string> = {
  webComponents: 'Web Components',
  react: 'React',
  angularSignals: 'Angular (signals)',
  vue: 'Vue',
};
---
<table>
  <thead>
    <tr><th>Framework</th><th>Structure mechanism</th><th>Variant mechanism</th></tr>
  </thead>
  <tbody>
    {entries.map(([key, val]) => (
      <tr>
        <td>{labels[key] ?? key}</td>
        <td>{val.structureMechanism}</td>
        <td>{val.variantMechanism}</td>
      </tr>
    ))}
  </tbody>
</table>
