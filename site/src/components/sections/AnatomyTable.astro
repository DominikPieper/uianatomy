---
import type { Component } from '@uianatomy/shared/schema';
import VersionBadges from './VersionBadges.astro';
interface Props { component: Component }
const { component } = Astro.props;
---
<div class="table-scroll">
  <table class="anatomy-table">
    <thead>
      <tr>
        <th>Slot</th>
        <th>Required</th>
        <th>Purpose</th>
      </tr>
    </thead>
    <tbody>
      {component.anatomy.map((slot) => (
        <tr data-slot={slot.id} class:list={[{ 'is-deprecated': !!slot.deprecated }]}>
          <td>
            <code>{slot.id}</code>
            <VersionBadges since={slot.since} deprecated={slot.deprecated} />
          </td>
          <td>{slot.required ? 'required' : 'optional'}</td>
          <td>{slot.purpose}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
