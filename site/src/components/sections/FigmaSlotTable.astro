---
import type { Component } from '@uianatomy/shared/schema';
import SubAnatomyBadge from './SubAnatomyBadge.astro';
interface Props { component: Component }
const { component } = Astro.props;
---
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Slot</th>
        <th>Figma type</th>
        <th>Hint</th>
      </tr>
    </thead>
    <tbody>
      {component.anatomy.map((s) => (
        <tr data-slot={s.id}>
          <td>
            <code>{s.id}</code>
            <SubAnatomyBadge entry={s} />
          </td>
          <td>{s.figma.type}</td>
          <td>{s.figma.hint}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
