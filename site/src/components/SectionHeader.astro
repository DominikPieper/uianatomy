---
import Icon from './Icon.astro';

type Role = 'designer' | 'dev' | 'both';

interface Props {
  role: Role;
  title: string;
  id?: string;
  numeral?: string;
}

const { role, title, id, numeral } = Astro.props;
const iconName = role === 'designer' ? 'palette' : role === 'dev' ? 'code' : 'git-compare';
const labelText = role === 'designer' ? 'Designer' : role === 'dev' ? 'Dev' : 'Both';
---
<header class="section-header" data-role={role}>
  <span class="role-badge" aria-label={`${labelText} relevance`}>
    <Icon name={iconName} size={12} />
    <span class="role-badge__label">{labelText}</span>
  </span>
  <h2 id={id}>{title}</h2>
  {numeral && <span class="section-header__numeral" aria-hidden="true">{numeral}</span>}
</header>

<style>
  .section-header__numeral {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: var(--ls-caps);
    color: var(--ink-400);
    text-transform: uppercase;
  }
</style>
