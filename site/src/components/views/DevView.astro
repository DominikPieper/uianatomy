---
import type { Component } from '@uianatomy/shared/schema';
import SectionHeader from '../SectionHeader.astro';
import CodeSlotTable from '../sections/CodeSlotTable.astro';
import AxesTable from '../sections/AxesTable.astro';
import TransitionsTable from '../sections/TransitionsTable.astro';
import FrameworkMapTable from '../sections/FrameworkMapTable.astro';
import EventsTable from '../sections/EventsTable.astro';
import A11yAcceptanceTable from '../sections/A11yAcceptanceTable.astro';
import FormIntegrationSection from '../sections/FormIntegrationSection.astro';
import PerformanceSection from '../sections/PerformanceSection.astro';
import MismatchesTable from '../sections/MismatchesTable.astro';
import MistakesList from '../sections/MistakesList.astro';
import A11yTable from '../sections/A11yTable.astro';

interface Props { component: Component }
const { component } = Astro.props;
---
<section data-view-section="dev">
  <SectionHeader role="dev" title="Code anatomy" id="code-anatomy" />
  <CodeSlotTable component={component} />

  <SectionHeader role="both" title="Variants, properties, states" id="axes" />
  <AxesTable component={component} />

  {component.axes.states.transitions && component.axes.states.transitions.length > 0 && (
    <>
      <SectionHeader role="both" title="State transitions" id="transitions" />
      <TransitionsTable component={component} />
    </>
  )}

  <SectionHeader role="dev" title="Cross-framework expression" id="framework-map" />
  <FrameworkMapTable component={component} />

  {component.events && component.events.length > 0 && (
    <>
      <SectionHeader role="both" title="Events" id="events" />
      <EventsTable component={component} />
    </>
  )}

  {component.formIntegration && (
    <>
      <SectionHeader role="dev" title="Form integration" id="form-integration" />
      <FormIntegrationSection component={component} />
    </>
  )}

  {component.performance && component.performance.length > 0 && (
    <>
      <SectionHeader role="dev" title="Performance thresholds" id="performance" />
      <PerformanceSection component={component} />
    </>
  )}

  <SectionHeader role="both" title="Accessibility" id="a11y" />
  <A11yTable component={component} />

  {component.a11yAcceptance && (
    <>
      <SectionHeader role="both" title="Accessibility acceptance" id="a11y-acceptance" />
      <A11yAcceptanceTable component={component} />
    </>
  )}

  <SectionHeader role="dev" title="Common mistakes" id="mistakes" />
  <MistakesList component={component} />

  <details>
    <summary>Figma↔Code mismatches</summary>
    <MismatchesTable component={component} />
  </details>
</section>
