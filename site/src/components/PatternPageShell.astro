---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ComponentTOC from './ComponentTOC.astro';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'patterns'>;
}

const { entry } = Astro.props;
const pattern = entry.data;

const SITE_ORIGIN = 'https://uianatomy.dev';
const url = `${SITE_ORIGIN}/patterns/${pattern.id}`;

const components = await getCollection('components');
const componentById = new Map(components.map((c) => [c.data.id, c.data]));

// ADR-038 — one page per pattern now; role is a client-side lens, not a route.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${url}#article`,
      headline: `${pattern.name} — composition, decisions, and cross-framework skeletons`,
      description: pattern.description,
      url,
      inLanguage: 'en-US',
      datePublished: pattern.lastReviewed,
      dateModified: pattern.lastReviewed,
      author: {
        '@type': 'Person',
        name: 'Dominik Pieper',
        url: 'https://github.com/DominikPieper',
        sameAs: ['https://github.com/DominikPieper'],
      },
      publisher: { '@id': `${SITE_ORIGIN}/#organization` },
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Components', item: `${SITE_ORIGIN}/` },
          { '@type': 'ListItem', position: 2, name: 'Patterns', item: `${SITE_ORIGIN}/patterns` },
          { '@type': 'ListItem', position: 3, name: pattern.name, item: `${SITE_ORIGIN}/patterns/${pattern.id}` },
        ],
      },
    },
    {
      '@type': 'HowTo',
      '@id': `${url}#howto`,
      name: pattern.name,
      description: pattern.description,
      url,
      step: pattern.composition.map((c, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: c.role,
        text: `Use the ${componentById.get(c.componentId)?.name ?? c.componentId} component as the ${c.role}.${c.notes ? ' ' + c.notes : ''}`,
        url: `${SITE_ORIGIN}/components/${c.componentId}`,
      })),
    },
  ],
};
---
<Base
  title={pattern.name}
  description={pattern.description}
  breadcrumb={[
    { name: 'Components', href: '/' },
    { name: 'Patterns', href: '/patterns' },
    { name: pattern.name },
  ]}
  ogType="article"
  articleModifiedTime={pattern.lastReviewed}
  jsonLd={jsonLd}
>
  <article class="shell pattern" data-pagefind-body data-pagefind-meta={`title:${pattern.name}`}>
    <header class="pattern__hero">
      <h1 class="pattern__name">{pattern.name}</h1>
      <p class="pattern__description">{pattern.description}</p>
    </header>

    <ComponentTOC />

    <slot />

    {pattern.notes && (
      <section class="pattern__section pattern__notes" aria-labelledby="notes">
        <h2 id="notes" class="pattern__h2">Notes</h2>
        <p>{pattern.notes}</p>
      </section>
    )}

    <footer class="pattern__footer">
      <span>
        <Icon name="clock" size={12} /> Last reviewed <time datetime={pattern.lastReviewed}>{pattern.lastReviewed}</time>
      </span>
    </footer>
  </article>
</Base>

<style>
  .pattern {
    max-width: var(--measure-prose);
    margin-inline: auto;
  }
  .pattern__hero {
    margin-bottom: 32px;
  }
  .pattern__name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 16px;
  }
  .pattern__description {
    color: var(--fg-muted);
    margin: 0 0 24px;
    font-size: 1.05em;
    line-height: 1.6;
  }
  .pattern__footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    font-size: 13px;
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }
</style>
