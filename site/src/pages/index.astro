---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ComponentCard from '../components/ComponentCard.astro';

const components = await getCollection('components');
components.sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<Base title="Components" description="Canonical reference for UI component anatomy — the same truth, in three views.">
  <div class="shell">
    <aside class="phase-banner" aria-label="Project status">
      <span class="phase-banner__tag">Phase 1</span>
      <p class="phase-banner__text">
        Reference only — no live examples and no implementation code yet. Phase 2 (implementation
        audits) begins Q3 2026.
      </p>
    </aside>

    <section class="component-hero">
      <p class="hero-eyebrow">A canonical reference</p>
      <h1 class="hero-title">UI Anatomy</h1>
      <p class="hero-lede">
        Component anatomy documented as <em>canon</em> — slots, axes, and translation. Switch
        between Designer, Dev, and Bridge views to read the same truth from your perspective.
      </p>
    </section>

    <nav aria-labelledby="components-heading">
      <h2 id="components-heading" class="section-rule">Components</h2>

      <ul class="component-grid" role="list">
        {components.map((entry) => (
          <li><ComponentCard component={entry.data} /></li>
        ))}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .component-grid {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .component-grid > li {
    display: contents;
  }
</style>
