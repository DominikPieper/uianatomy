---
import { getCollection, getEntry } from 'astro:content';
import { Code } from 'astro-expressive-code/components';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const patterns = await getCollection('patterns');
  return patterns.map((entry) => ({ params: { id: entry.data.id } }));
}

const { id } = Astro.params;
const entry = await getEntry('patterns', id!);
if (!entry) throw new Error(`Pattern ${id} not found`);
const pattern = entry.data;

const SITE_ORIGIN = 'https://uianatomy.dev';
const url = `${SITE_ORIGIN}/patterns/${pattern.id}`;

const components = await getCollection('components');
const componentById = new Map(components.map((c) => [c.data.id, c.data]));

const SKELETON_LANG: Record<keyof typeof pattern.frameworkSkeletons, string> = {
  webComponents: 'html',
  react: 'tsx',
  vue: 'vue',
  angularSignals: 'html',
};
const SKELETON_LABEL: Record<keyof typeof pattern.frameworkSkeletons, string> = {
  webComponents: 'Web Components',
  react: 'React',
  vue: 'Vue',
  angularSignals: 'Angular (signals)',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${url}#article`,
      headline: `${pattern.name} — canonical composition`,
      description: pattern.description,
      url,
      inLanguage: 'en-US',
      datePublished: pattern.lastReviewed,
      dateModified: pattern.lastReviewed,
      author: {
        '@type': 'Person',
        name: 'Dominik Pieper',
        url: 'https://github.com/DominikPieper',
        sameAs: ['https://github.com/DominikPieper'],
      },
      publisher: { '@id': `${SITE_ORIGIN}/#organization` },
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Components', item: `${SITE_ORIGIN}/` },
          { '@type': 'ListItem', position: 2, name: 'Patterns', item: `${SITE_ORIGIN}/patterns` },
          { '@type': 'ListItem', position: 3, name: pattern.name, item: url },
        ],
      },
    },
    {
      '@type': 'HowTo',
      '@id': `${url}#howto`,
      name: pattern.name,
      description: pattern.description,
      url,
      step: pattern.composition.map((c, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: c.role,
        text: `Use the ${componentById.get(c.componentId)?.name ?? c.componentId} component as the ${c.role}.${c.notes ? ' ' + c.notes : ''}`,
        url: `${SITE_ORIGIN}/components/${c.componentId}`,
      })),
    },
  ],
};
---
<Base
  title={pattern.name}
  description={pattern.description}
  breadcrumb={[
    { name: 'Components', href: '/' },
    { name: 'Patterns', href: '/patterns' },
    { name: pattern.name },
  ]}
  ogType="article"
  articleModifiedTime={pattern.lastReviewed}
  jsonLd={jsonLd}
>
  <article class="shell pattern" data-pagefind-body>
    <header class="pattern__hero">
      <p class="hero-eyebrow">Pattern</p>
      <h1 class="pattern__name">{pattern.name}</h1>
      <p class="pattern__description">{pattern.description}</p>
    </header>

    <section class="pattern__section" aria-labelledby="composition">
      <h2 id="composition" class="pattern__h2">Composition</h2>
      <ol class="pattern__composition">
        {pattern.composition.map((c) => {
          const comp = componentById.get(c.componentId);
          return (
            <li>
              <header class="pattern__composition-head">
                <a class="pattern__composition-name" href={`/components/${c.componentId}`}>
                  {comp?.name ?? c.componentId}
                </a>
                <span class="pattern__composition-role">{c.role}</span>
              </header>
              {c.notes && <p class="pattern__composition-notes">{c.notes}</p>}
            </li>
          );
        })}
      </ol>
    </section>

    <section class="pattern__section" aria-labelledby="when-to-use">
      <h2 id="when-to-use" class="pattern__h2">When to use</h2>
      <dl class="pattern__when">
        <dt>Use</dt>
        <dd>{pattern.whenToUse.use}</dd>
        <dt>Avoid</dt>
        <dd>{pattern.whenToUse.avoid}</dd>
      </dl>
    </section>

    <section class="pattern__section" aria-labelledby="decisions">
      <h2 id="decisions" class="pattern__h2">Canonical decisions</h2>
      <ol class="pattern__decisions">
        {pattern.decisions.map((d) => (
          <li>
            <h3 class="pattern__decision-q">{d.question}</h3>
            <p class="pattern__decision-a"><strong>{d.answer}</strong></p>
            <p class="pattern__decision-r">{d.rationale}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="pattern__section" aria-labelledby="mistakes">
      <h2 id="mistakes" class="pattern__h2">Common mistakes</h2>
      <ol class="pattern__mistakes">
        {pattern.mistakes.map((m) => (
          <li>
            <h3 class="pattern__mistake-title">{m.title}</h3>
            <p>{m.description}</p>
            <p class="pattern__mistake-fix"><strong>Fix.</strong> {m.fix}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="pattern__section" aria-labelledby="skeletons">
      <h2 id="skeletons" class="pattern__h2">Framework skeletons</h2>
      <p class="pattern__skeletons-lede">
        Composition shape only. Each library will diverge in API surface
        (see the <a href={`/components/${pattern.composition[0].componentId}`}>component pages</a>
        for divergence audits).
      </p>
      {(['webComponents', 'react', 'vue', 'angularSignals'] as const).map((key) => (
        <div class="pattern__skeleton">
          <h3 class="pattern__skeleton-label">{SKELETON_LABEL[key]}</h3>
          <Code code={pattern.frameworkSkeletons[key]} lang={SKELETON_LANG[key]} wrap={true} />
        </div>
      ))}
    </section>

    {pattern.notes && (
      <section class="pattern__section pattern__notes" aria-labelledby="notes">
        <h2 id="notes" class="pattern__h2">Notes</h2>
        <p>{pattern.notes}</p>
      </section>
    )}

    <footer class="pattern__footer">
      <span>
        Last reviewed <time datetime={pattern.lastReviewed}>{pattern.lastReviewed}</time>
      </span>
    </footer>
  </article>
</Base>

<style>
  .pattern {
    max-width: var(--measure-prose);
    margin-inline: auto;
  }
  .pattern__hero {
    margin-bottom: 48px;
  }
  .pattern__name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 16px;
  }
  .pattern__description {
    color: var(--fg-muted);
    margin: 0;
    font-size: 1.05em;
    line-height: 1.6;
  }
  .pattern__section {
    margin-block: 48px;
  }
  .pattern__h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .pattern__composition,
  .pattern__decisions,
  .pattern__mistakes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .pattern__composition li,
  .pattern__decisions li,
  .pattern__mistakes li {
    border-left: 2px solid var(--accent-active);
    padding: 4px 0 4px 16px;
  }
  .pattern__composition-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .pattern__composition-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: inherit;
  }
  .pattern__composition-role {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .pattern__composition-notes {
    margin: 0;
    line-height: 1.65;
  }
  .pattern__when {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 24px;
    margin: 0;
  }
  .pattern__when dt {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    padding-top: 4px;
  }
  .pattern__when dd {
    margin: 0;
    line-height: 1.65;
  }
  .pattern__decision-q {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0 0 6px;
  }
  .pattern__decision-a,
  .pattern__decision-r {
    margin: 0 0 6px;
    line-height: 1.6;
  }
  .pattern__mistake-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0 0 6px;
  }
  .pattern__mistake-fix {
    margin: 8px 0 0;
    line-height: 1.6;
  }
  .pattern__skeletons-lede {
    color: var(--fg-muted);
    margin: 0 0 16px;
  }
  .pattern__skeleton {
    margin-block: 24px;
  }
  .pattern__skeleton-label {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    margin: 0 0 8px;
  }
  .pattern__notes p {
    color: var(--fg-muted);
    line-height: 1.65;
  }
  .pattern__footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    font-size: 13px;
    color: var(--fg-muted);
  }
</style>
