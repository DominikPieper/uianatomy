---
import { getCollection, type CollectionEntry } from 'astro:content';
import ComponentPageShell from '../../components/ComponentPageShell.astro';
import DesignerView from '../../components/views/DesignerView.astro';

export async function getStaticPaths() {
  const components = await getCollection('components');
  return components.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'components'> }
const { entry } = Astro.props;
---
<ComponentPageShell entry={entry} view="designer">
  <DesignerView component={entry.data} />
</ComponentPageShell>
