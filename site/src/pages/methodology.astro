---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
// Vite ?raw inlines the file contents at compile time, avoiding the
// build/runtime path resolution split. docs/methodology.md is the
// canonical source; this page is a public surface of the same prose.
import raw from '../../../docs/methodology.md?raw';

const SITE_ORIGIN = 'https://uianatomy.dev';
const url = `${SITE_ORIGIN}/methodology`;
const html = marked.parse(raw, { gfm: true, async: false }) as string;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${url}#about`,
      url,
      name: 'Methodology — UI Anatomy',
      inLanguage: 'en-US',
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      description:
        'How UI Anatomy researches, writes, and validates each canonical component — sources, synthesis, ' +
        'editorial discipline, minimum-depth contract, and consistency safeguards.',
      mainEntity: { '@id': `${url}#article` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Components', item: `${SITE_ORIGIN}/` },
          { '@type': 'ListItem', position: 2, name: 'Methodology', item: url },
        ],
      },
    },
    {
      '@type': 'TechArticle',
      '@id': `${url}#article`,
      headline: 'How the canon is researched and written',
      url,
      inLanguage: 'en-US',
      description:
        'Editorial methodology behind the UI Anatomy canon: canon-first separation from implementations, ' +
        'three-category source triangulation (specs, mature libraries, design systems), the variant / property ' +
        'state distinction, and the minimum-depth contract enforced in CI.',
      author: {
        '@type': 'Person',
        name: 'Dominik Pieper',
        url: 'https://github.com/DominikPieper',
        sameAs: ['https://github.com/DominikPieper'],
      },
      publisher: { '@id': `${SITE_ORIGIN}/#organization` },
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
    },
  ],
};
---
<Base
  title="Methodology"
  description="How UI Anatomy researches, writes, and validates each canonical component — sources, synthesis, editorial discipline, minimum-depth contract, and consistency safeguards."
  breadcrumb={[{ name: 'Components', href: '/' }, { name: 'Methodology' }]}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="shell methodology" data-pagefind-body>
    <Fragment set:html={html} />
  </article>
</Base>

<style>
  .methodology {
    max-width: var(--measure-prose);
    margin-inline: auto;
  }
  .methodology :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 24px;
  }
  .methodology :global(h2) {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 48px 0 12px;
  }
  .methodology :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    margin: 32px 0 8px;
  }
  .methodology :global(p),
  .methodology :global(li) {
    line-height: 1.65;
  }
  .methodology :global(ul),
  .methodology :global(ol) {
    padding-inline-start: 1.25em;
    margin: 12px 0;
  }
  .methodology :global(li) {
    margin: 6px 0;
  }
  .methodology :global(hr) {
    border: 0;
    border-top: 1px solid var(--border-subtle);
    margin: 40px 0;
  }
  .methodology :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    padding: 1px 6px;
  }
  .methodology :global(table) {
    width: 100%;
    border-collapse: collapse;
  }
  .methodology :global(th),
  .methodology :global(td) {
    border: 1px solid var(--border-subtle);
    padding: 8px 12px;
    text-align: start;
    vertical-align: top;
  }
  .methodology :global(th) {
    background: var(--surface-sunken);
    font-weight: 500;
  }
</style>
