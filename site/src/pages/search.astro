---
import Base from '../layouts/Base.astro';
import Search from 'astro-pagefind/components/Search';

const initialQuery = Astro.url.searchParams.get('q') ?? '';
---
<Base
  title="Search"
  description="Search the UI Anatomy canon — components, slots, mismatches, mistakes, accessibility acceptance."
  breadcrumb={[{ name: 'Search' }]}
>
  <article class="shell measure-wide" style="margin-inline:auto;">
    <section class="search-page">
      <header class="search-page__header">
        <h1>Search</h1>
        <p class="search-page__lede">
          Full-text search across all canonical components — anatomy
          slots, axes, mismatches, mistakes, accessibility acceptance,
          framework mappings, and the rest of the canon. Each result
          links to the matching component page.
        </p>
      </header>
      <Search
        className="search-page__pagefind"
        query={initialQuery}
        uiOptions={{
          showImages: false,
          showSubResults: true,
          excerptLength: 24,
          resetStyles: false,
          autofocus: true,
        }}
      />
    </section>
  </article>
</Base>

<style>
  .search-page {
    margin: 0 0 32px;
  }
  .search-page__header {
    margin: 0 0 24px;
  }
  .search-page__header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .search-page__lede {
    margin: 0;
    color: var(--fg-muted);
    line-height: var(--leading-normal, 1.5);
    max-width: var(--measure-prose);
  }
  .search-page__pagefind {
    --pagefind-ui-primary: var(--accent-active, var(--text-primary));
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--surface-bg);
    --pagefind-ui-border: var(--border-subtle);
    --pagefind-ui-tag: var(--surface-sunken);
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-body, system-ui);
  }
</style>
